#!/usr/bin/env bash
# Lightweight lsof compatibility fallback for Tokscale port discovery
PID=""
while [ $# -gt 0 ]; do
  case "$1" in
    -p)
      PID="$2"
      shift 2
      ;;
    *)
      shift
      ;;
  esac
done

echo "COMMAND     PID USER   FD   TYPE DEVICE SIZE/OFF NODE NAME"
if [ -n "$PID" ]; then
  ss -tlpn -H 2>/dev/null | grep "pid=$PID," | while read -r line; do
    ADDR=$(echo "$line" | awk '{print $4}')
    PORT="${ADDR##*:}"
    if [ -n "$PORT" ]; then
      echo "language_ $PID $(whoami)   15u  IPv4  12345      0t0  TCP 127.0.0.1:$PORT (LISTEN)"
    fi
  done
else
  ss -tlpn -H 2>/dev/null | while read -r line; do
    PID_MATCH=$(echo "$line" | grep -o 'pid=[0-9]*' | head -1 | cut -d= -f2)
    ADDR=$(echo "$line" | awk '{print $4}')
    PORT="${ADDR##*:}"
    if [ -n "$PID_MATCH" ] && [ -n "$PORT" ]; then
      echo "proc $PID_MATCH $(whoami)   15u  IPv4  12345      0t0  TCP 127.0.0.1:$PORT (LISTEN)"
    fi
  done
fi
